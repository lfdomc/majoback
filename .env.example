# Copie a .env para desarrollo local, o defina estas variables en Railway
SECRET_KEY=cambie-esto-por-un-texto-largo-y-aleatorio
ADMIN_USUARIO=admin
ADMIN_CLAVE=una-clave-segura
CORS_ORIGINS=https://costeo.pages.dev,http://localhost:5173
DATABASE_PATH=/data/costeo.db
CARGAR_DATOS_INICIALES=si
# Publicar el menú en Cloudflare R2 (opcional; si falta alguna, se apaga)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dolce-marju-menu
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
